# Ignore some tools
tools/n64crc
tools/ido5.3_recomp/

# Ignore OS and IDE folders
.vscode/
__pycache__/
.venv/
.DS_Store

# Ignore the baserom so it doesn't get accidentally added
*.z64
*.n64
*.rom
*.eeprom
*.pak

# Automatically generated folders should be ignored
build/
expected/
# asm/
src/assets/*
include/assets/*
bin/
mio0/

# Automatically generated files, so they should be ignored
waverace64.ld
waverace64.d
undefined_funcs_auto.txt
undefined_syms_auto.txt
torch.hash.yml
*_auto.ld

# CTX files for m2c should be ignored as we generate those
ctx.c
ctx_includes.c
ctx.c.m2c
venv/*
# Ignore compiled object files and scratch build artifacts
*.o
scratch/*.o
scratch/*.dis
scratch/*.err

# Local probe / experiment workspace (never committed)
scratch/
graphify-out/
# Unused bundled IRIX compiler copies; the build uses tools/ido-static-recomp
tools/ido5.3_cc/
tools/ido5.3_compiler/
tools/ido7.1_compiler/
tools/ido-static-recomp/
tools/Torch/
